# Cloudflare Pages custom headers.
#
# The default was `Cache-Control: public, max-age=14400, must-revalidate` on
# everything, including HTML. That meant a deploy was invisible on aqlamna.org
# for up to four hours: after shipping a fix, /editor/ still referenced the
# PREVIOUS build's content-hashed bundle, and purging by URL did not reliably
# clear it. Two separate "it is still broken" reports came from this, not from
# the code.
#
# So: never cache the documents, always cache the fingerprinted assets.

# Content-hashed by Vite — the filename changes whenever the bytes change, so
# these are safe to keep forever.
/editor/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Documents and the PWA control files. These filenames never change, so they
# must be revalidated every time or a deploy cannot reach anyone.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/editor/
  Cache-Control: public, max-age=0, must-revalidate
/editor/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/docs/*
  Cache-Control: public, max-age=0, must-revalidate
