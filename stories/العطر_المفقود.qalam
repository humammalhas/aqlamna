// العطر المفقود — قصة تفاعلية قصيرة
// المثال الرسمي لمحرك أقلامنا. مكتوبة وفق قواعد ARABIC_MASTERY.md

عنوان: "العطر المفقود"
مؤلف: "أقلامنا"

متغير المكوّنات = 0
متغير الثقة = 0
متغير عرفتِ_السرّ = خطأ
متغير حاولتِ_الخلط = خطأ

=== الدكّان === #مشهد_أول

رفوف الخشب تصطفّ حتى السقف، وفي كلّ جرّة رائحةٌ تنتظر. المعلّم سليم يجلس وراء ميزانٍ نحاسيّ، وأمامه ورقة صفراء لا شيء عليها.

"وصفة جدّتي ضاعت،" قال دون أن يرفع عينيه. "أعرف أنّ فيها أربعة أشياء. أذكر ثلاثة، والرابع يهرب منّي كلّما اقتربتُ."

* [اسأليه عن الثلاثة]
  -> الجرار

* [تأمّلي الدكّان أولًا]
  مررتِ بأصابعكِ على حرف الرفّ فتركت الغبار خطًّا رقيقًا. في الزاوية العليا جرّةٌ وحدها، لا ورقة عليها ولا اسم.
  ~ الثقة = الثقة + 1
  "عينكِ حادّة،" قال. "لكن ابدئي من الأسفل."
  -> الجرار

=== الجرار ===

فتح ثلاث جرارٍ ووضعها في الضوء.

"زهر النارنج،" قال، ورفع أولاها. رائحةٌ حمضيّة تلسع الأنف ثمّ تحلو.
"ماء الورد. من قطف الفجر لا من قطف الظهر."
"والعود. هذا لا يُشترى من السوق."

"اجمعيها لي،" قال. "ثمّ نرى ما ينقص."

-> المهمّة

=== المهمّة ===

{المكوّنات:
  - المكوّنات == 0: الورقة الصفراء أمامكِ فارغة. لا شيء بعد.
  - المكوّنات < 3: جمعتِ {المكوّنات} من ثلاثة. الورقة تنتظر بقيّتها.
  - غير_ذلك: الثلاثة أمامكِ. رائحةٌ واحدة ما زالت غائبة.
}

* [إلى سوق البخاريّة — زهر النارنج]
  -> السوق

* [إلى بيت جدّتكِ — ماء الورد]
  -> البيت

* [إلى المخزن — العود]
  -> المخزن

+ {المكوّنات >= 3} [اخلطي العطر]
  -> الخلط

+ {حاولتِ_الخلط} [اسألي المعلّم عن الجرّة العليا]
  -> الجرّة_العليا

=== السوق ===

الشمس عمودية والدرج ضيّق. صاحب الدكّان يعرف المعلّم سليم منذ أربعين سنة.

"النارنج؟" ضحك. "خُذي من شجرة الحوش، لا من عندي. شجرتنا أطيب."

قطفتِ الزهر بيدكِ. البتلة باردة وقصيرة العمر.

~ المكوّنات = المكوّنات + 1
-> المهمّة

=== البيت ===

باب البيت القديم يصرّ. في المطبخ قدرٌ نحاسيّ مقلوب، وتحته زجاجةٌ صغيرة كُتب عليها بخطّ يدٍ مائل: "ورد ٦٧".

* [افتحيها]
  ملأت الرائحة المطبخ دفعةً واحدة، فوقفتِ مكانكِ. ورد قديم، وشيءٌ آخر تحته لم تعرفيه.
  ~ المكوّنات = المكوّنات + 1
  ~ الثقة = الثقة + 1
  -> المهمّة

* [خُذيها مغلقة]
  حملتِها كما هي. للمعلّم حقّ أن يفتحها هو.
  ~ المكوّنات = المكوّنات + 1
  ~ الثقة = الثقة + 1
  -> المهمّة

=== المخزن ===

المخزن بارد ولا نافذة فيه. صندوق العود مقفل، والمفتاح عند المعلّم.

* [عودي واطلبي المفتاح]
  أعطاكِ المفتاح دون سؤال. القطعة أصغر من إصبعكِ وأثقل ممّا توقّعتِ.
  ~ المكوّنات = المكوّنات + 1
  ~ الثقة = الثقة + 1
  -> المهمّة

* [افتحي الصندوق بمفكّ]
  انكسر اللسان المعدنيّ فانفتح الصندوق. أخذتِ القطعة، وفي يدكِ برادةٌ من نحاس.
  ~ المكوّنات = المكوّنات + 1
  -> المهمّة

=== الخلط ===

{حاولتِ_الخلط: كرّرتِ الترتيب الذي علّمكِ إيّاه، وأضفتِ ما وجدتِه في الجرّة العليا.}

قطرتان من ماء الورد. زهر النارنج مفرومًا ناعمًا. برادة العود على النار الهادئة.

{لا حاولتِ_الخلط:
  رفع المعلّم الزجاجة إلى النور وشمّها مرّتين. ثمّ أنزلها.
}

{عرفتِ_السرّ:
  شمّها، فسكت طويلًا. "هذه هي."
}

{لا عرفتِ_السرّ:
  "قريب،" قال. "قريب جدًّا. لكنّه ليس عطر جدّتي."
  ~ حاولتِ_الخلط = صح
  -> المهمّة
}

-> الخاتمة

=== الجرّة_العليا ===

سألتِه عن الجرّة التي لا اسم عليها.

نظر إليها كمن يتذكّر وجهًا. "هذه ليست مكوّنًا. هذا خشب الرفّ نفسه — صندل قديم، كان أبوها يبيعه قبل أن يصير الدكّان دكّانًا."

فتحها. الرائحة رائحة الدكّان في الصباح، قبل أن يفتح الباب.

"جدّتي لم تضعه في الوصفة،" قال. "الوصفة هي التي جلست فيه أربعين سنة."

~ المكوّنات = المكوّنات + 1
~ عرفتِ_السرّ = صح
~ الثقة = الثقة + 1

-> المهمّة

=== الخاتمة ===

{الثقة:
  - الثقة < 3: كتب المعلّم أسماء المكوّنات الأربعة على الورقة الصفراء، وطواها في جيبه.
  - غير_ذلك: كتب المعلّم أسماء المكوّنات الأربعة على الورقة الصفراء، ثمّ دفعها إليكِ. "اكتبي تحتها اسمكِ. من يعرف الرابع يعرف الوصفة."
}

جمعتِ {المكوّنات} مكوّنات، ورائحة الدكّان لا تزال في كمّكِ.

-> نهاية
