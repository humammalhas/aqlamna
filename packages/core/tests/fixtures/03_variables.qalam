عنوان: "الرحيق"

متغير الرحيق = 0
متغير وجد_الخريطة = خطأ
متغير اسم_البطل = "نحلة"

=== البداية ===

{وجد_الخريطة: الخريطة معك.}
جمعتِ {الرحيق} قطرة.

+ [اجمع الرحيق]
  ~ الرحيق = الرحيق + 2
  -> البداية

* [تحدثي مع النحلة الحكيمة]
  ~ وجد_الخريطة = صح
  -> البداية

+ {الرحيق >= 4} [عودي إلى الخلية]
  -> نهاية
