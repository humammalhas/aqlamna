{
  "name": "@aqlamna/editor",
  "version": "0.1.0",
  "private": true,
  "description": "Aqlamna visual editor — Vite + React app",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "npm run build -w @aqlamna/runtime && node scripts/copy-runtime.mjs && node scripts/build-mastery-prompt.mjs && npm run build -w @aqlamna/core && vite",
    "build": "npm run build -w @aqlamna/runtime && node scripts/copy-runtime.mjs && node scripts/build-mastery-prompt.mjs && npm run build -w @aqlamna/core && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@aqlamna/core": "*",
    "@aqlamna/runtime": "*",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/highlight": "^1.2.3",
    "@xyflow/react": "^12.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.1.0"
  }
}
